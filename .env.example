# Copy this file to .env and fill in your values.
# .env is gitignored — never commit credentials.

# TimescaleDB connection string
# Local Docker:  postgresql://postgres:password@localhost:5432/cooling_tower
# Remote:        postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/cooling_tower

# Optional: MQTT broker (used by pipeline/mqtt_publisher.py)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=cooling_tower
